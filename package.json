{
  "name": "better-ytm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^22.21.0 || >=24.10.0",
    "pnpm": ">=12.5.1 <13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:extension": "pnpm --filter @better-ytm/extension dev",
    "dev:server": "pnpm --filter @better-ytm/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "start:server": "pnpm --filter @better-ytm/server start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
